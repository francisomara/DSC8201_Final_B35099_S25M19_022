    "\n",
    "g = so.groupby(\"seller_id\")\n",
    "sf = pd.DataFrame({\"n_orders\": g.order_id.nunique(), \"revenue\": g.price.sum(), \"items\": g.n_items.sum()})\n",
    "sf[\"avg_price\"] = sf.revenue / sf[\"items\"]\n",
    "sf[\"n_categories\"] = it.groupby(\"seller_id\").category.nunique()\n",
    "first, last = g.order_purchase_timestamp.min(), g.order_purchase_timestamp.max()\n",
    "sf[\"active_months\"] = ((last - first).dt.days / 30.44).round() + 1\n",
    "dl = so[so.order_status == \"delivered\"]; gd = dl.groupby(\"seller_id\")\n",
    "sf[\"late_rate\"] = gd.late.mean()\n",
    "sf[\"avg_delay_when_late\"] = dl[dl.late == 1].groupby(\"seller_id\").delay_days.mean()\n",
    "sf[\"avg_review\"] = g.review_score.mean()\n",
    "sf[\"handover_days\"] = gd.handover_days.mean()\n",
    "sf[\"freight_ratio\"] = g.freight.sum() / g.price.sum()\n",
    "sf[\"n_states\"] = g.customer_state.nunique()\n",
    "sf[\"cancel_rate\"] = g.cancelled.mean()\n",
