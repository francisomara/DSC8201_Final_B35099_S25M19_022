    "# Rule layer (hard business inconsistencies)\n",
    "A[\"r_payment_mismatch\"] = A.gap_ratio > 0.05\n",
    "A[\"r_freight_gt_price\"] = A.freight_ratio > 1\n",
    "A[\"r_time_inconsistent\"] = (A.order_delivered_customer_date < A.order_purchase_timestamp) | (A.order_delivered_carrier_date < A.order_purchase_timestamp)\n",
    "A[\"r_very_late\"] = A.delay_days > 30\n",
    "rules = [c for c in A.columns if c.startswith(\"r_\") and not c.endswith(\"_r\")]\n",
    "display(A[rules].sum().to_frame(\"orders flagged\"))\n",
    "\n",
    "# Agreement and stability\n",
    "TOP = 0.01\n",
    "sel = lambda s, q=TOP: s >= s.quantile(1 - q)\n",
    "sets = {n: set(A.index[sel(A[n])]) for n in [\"s_if\",\"s_lof\",\"s_mcd\"]}\n",
    "ns = list(sets)\n",
    "print(\"Jaccard of top-1% sets:\", {f\"{a}-{b}\": round(len(sets[a] & sets[b]) / len(sets[a] | sets[b]), 2) for i, a in enumerate(ns) for b in ns[i+1:]})\n",
    "s2 = iforest(7)\n",
    "print(\"Isolation Forest seed stability: Spearman =\", round(spearmanr(A.s_if, s2)[0], 3), \"| top-1% overlap =\", round(len(set(A.index[sel(pd.Series(s2))]) & sets[\"s_if\"]) / len(sets[\"s_if\"]), 2))\n",
    "for q in [0.005, 0.01, 0.02]:\n",
