    "clf.fit(tr_in[FEAT], tr_in.late.astype(int), eval_set=[(va[FEAT], va.late.astype(int))], eval_metric=\"average_precision\",\n",
    "        callbacks=[lgb.early_stopping(100, verbose=False)])\n",
    "BEST_N = max(clf.best_iteration_, 50)\n",
