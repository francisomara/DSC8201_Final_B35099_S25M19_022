    "import lightgbm as lgb\n",
    "from sklearn.pipeline import make_pipeline\n",
    "from sklearn.impute import SimpleImputer\n",
    "from sklearn.linear_model import LogisticRegression, Ridge\n",
    "from sklearn.model_selection import TimeSeriesSplit\n",
    "from sklearn.metrics import (average_precision_score, roc_auc_score, brier_score_loss, f1_score, precision_score, recall_score,\n",
    "                             confusion_matrix, mean_absolute_error, mean_squared_error, median_absolute_error, r2_score)\n",
    "y_tr, y_te = tr.late.astype(int), te.late.astype(int)\n",
    "res = {}\n",
    "res[\"Prevalence (always on time)\"] = dict(PR_AUC=y_te.mean(), ROC_AUC=0.5)\n",
    "rule = te.distance_km / te.est_days\n",
    "res[\"Rule: distance / promised days\"] = dict(PR_AUC=average_precision_score(y_te, rule), ROC_AUC=roc_auc_score(y_te, rule))\n",
    "for name, cols in {\"Logistic: est_days + distance\": [\"est_days\",\"distance_km\"], \"Logistic: all numeric\": NUM}.items():\n",
    "    lr_ = make_pipeline(SimpleImputer(strategy=\"median\"), StandardScaler(), LogisticRegression(max_iter=2000)).fit(tr[cols], y_tr)\n",
    "    p = lr_.predict_proba(te[cols])[:, 1]\n",
    "    res[name] = dict(PR_AUC=average_precision_score(y_te, p), ROC_AUC=roc_auc_score(y_te, p), Brier=brier_score_loss(y_te, p))\n",
    "\n",
    "# small time-series CV grid on the training period\n",
    "def cv_clf(params, cols=FEAT):\n",
    "    sc = []\n",
    "    for a, b in TimeSeriesSplit(3).split(tr):\n",
    "        m = lgb.LGBMClassifier(n_estimators=300, learning_rate=0.05, subsample=0.8, subsample_freq=1, colsample_bytree=0.8, random_state=SEED, verbose=-1, **params)\n",
    "        m.fit(tr.iloc[a][cols], y_tr.iloc[a]); sc.append(average_precision_score(y_tr.iloc[b], m.predict_proba(tr.iloc[b][cols])[:, 1]))\n",
    "    return np.mean(sc)\n",
    "grid = [dict(num_leaves=nl, min_child_samples=mc) for nl in [15, 31, 63] for mc in [20, 100]]\n",
    "cvres = pd.DataFrame([{**g_, \"cv_PR_AUC\": cv_clf(g_)} for g_ in grid]).sort_values(\"cv_PR_AUC\", ascending=False)\n",
    "display(cvres)\n",
    "best = {k: int(v) for k, v in cvres.iloc[0][[\"num_leaves\",\"min_child_samples\"]].items()}\n",
    "\n",
