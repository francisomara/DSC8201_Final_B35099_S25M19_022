    "# (i) threshold sensitivity\n",
    "for mc in [5, 10, 20, 50]:\n",
    "    p = pair_table(ohe, mc)\n",
    "    print(f\"min_count={mc:>3}: {len(p):>4} pairs | top-5 by lift: {[f'{a}+{b}' for a,b in p[['a','b']].head(5).values]}\")\n",
    "\n",
    "# (ii) stability across time (2017 vs 2018)\n",
    "yr = bk.groupby(\"order_id\").order_purchase_timestamp.min().dt.year.reindex(ohe.index)\n",
    "p17, p18 = pair_table(ohe[yr == 2017], 5), pair_table(ohe[yr == 2018], 5)\n",
    "mg = p17.merge(p18, on=[\"a\",\"b\"], suffixes=(\"_2017\",\"_2018\"))\n",
    "from scipy.stats import spearmanr\n",
    "print(\"pairs with lift>1 in 2017:\", len(p17), \"| in 2018:\", len(p18), \"| in both:\", len(mg), \"| Spearman of lift (common pairs):\", round(spearmanr(mg.lift_2017, mg.lift_2018)[0], 3) if len(mg) > 2 else \"n/a (too few)\")\n",
    "display(mg.sort_values(\"count_2017\", ascending=False)[[\"a\",\"b\",\"count_2017\",\"lift_2017\",\"count_2018\",\"lift_2018\"]].head(10))\n",
    "\n",
    "# (iii) permutation null: shuffle category labels across item rows of multi-item orders (basket sizes preserved)\n",
    "from scipy import sparse\n",
    "oc_codes = pd.factorize(bk_m.order_id)[0]\n",
    "cats, cat_codes = np.unique(bk_m.category, return_inverse=True)\n",
    "def max_lift(cc, min_count=MIN_COUNT):\n",
    "    M = sparse.csr_matrix((np.ones(len(oc_codes)), (oc_codes, cc)), shape=(oc_codes.max()+1, len(cats)))\n",
    "    M.data = np.minimum(M.data, 1)\n",
    "    co = (M.T @ M).toarray(); c = np.diag(co).copy(); np.fill_diagonal(co, 0)\n",
    "    lift = co * M.shape[0] / np.outer(c, c).clip(1)\n",
    "    lift[co < min_count] = 0\n",
    "    return lift.max()\n",
    "null = np.array([max_lift(rng.permutation(cat_codes)) for _ in range(100)])\n",
    "print(f\"observed max lift {pairs.lift.max():.2f} vs permutation null: mean {null.mean():.2f}, 95th pct {np.percentile(null,95):.2f}\")\n",
    "print(\"pairs whose lift exceeds the null 95th percentile:\", (pairs.lift > np.percentile(null, 95)).sum(), \"of\", len(pairs))\n",
    "\n",
    "# (iv) customer-level basket (all categories ever bought by a person) as a sensitivity variant\n",
    "bc = bk.merge(orders[[\"order_id\",\"customer_id\"]], on=\"order_id\").merge(cust[[\"customer_id\",\"customer_unique_id\"]], on=\"customer_id\")\n",
    "ohe_c = pd.crosstab(bc.customer_unique_id, bc.category).clip(upper=1).astype(bool)\n",
    "ohe_c = ohe_c[bc.groupby(\"customer_unique_id\").size().reindex(ohe_c.index) >= 2]   # customers with >= 2 items overall\n",
    "print(f\"customer-level (>=2 items): {len(ohe_c):,} customers | multi-category: {(ohe_c.sum(axis=1) > 1).mean():.1%}\")\n",
    "pairs_c = pair_table(ohe_c, MIN_COUNT)\n",
    "print(\"customer-level pairs (lift>1, count>=%d): %d | overlap with order-level pairs: %d\" % (MIN_COUNT, len(pairs_c), len(pairs.merge(pairs_c, on=[\"a\",\"b\"]))))\n",
    "display(pairs_c.head(10))"
