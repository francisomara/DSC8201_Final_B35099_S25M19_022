     "text": [
      "train 76,661 (inner 65,161 / val 11,500) | test 19,166 | cutoff 2018-05-25\n",
      "late rate train/test: 0.088 0.053 | mean days train/test: 13.5 8.8\n"
     ]
    }
   ],
   "source": [
    "d = df_del.sort_values(\"order_purchase_timestamp\").reset_index(drop=True)\n",
    "\n",
    "def seller_history(d):\n",
    "    n_prior = np.zeros(len(d)); lr = np.full(len(d), np.nan); md_ = np.full(len(d), np.nan)\n",
    "    for sid, g in d.groupby(\"seller_id\"):\n",
    "        ge = g.sort_values(\"order_delivered_customer_date\")\n",
    "        dd = ge.order_delivered_customer_date.values\n",
    "        cl, cd = np.cumsum(ge.late.values), np.cumsum(ge.delivery_days.values)\n",
    "        pos = np.searchsorted(dd, g.order_purchase_timestamp.values, side=\"left\")   # only deliveries completed BEFORE purchase\n",
    "        idx, ok = g.index.values, pos > 0\n",
    "        n_prior[idx] = pos\n",
    "        lr[idx[ok]] = cl[pos[ok] - 1] / pos[ok]\n",
    "        md_[idx[ok]] = cd[pos[ok] - 1] / pos[ok]\n",
    "    return n_prior, lr, md_\n",
    "d[\"seller_n_prior\"], d[\"seller_late_rate\"], d[\"seller_mean_days\"] = seller_history(d)\n",
    "\n",
    "top_cat = d.category.value_counts().head(25).index\n",
    "d[\"category_top\"] = d.category.where(d.category.isin(top_cat), \"other\")\n",
    "d[\"purchase_month\"] = d.order_purchase_timestamp.dt.month\n",
    "d[\"purchase_dow\"] = d.order_purchase_timestamp.dt.dayofweek\n",
    "d[\"purchase_hour\"] = d.order_purchase_timestamp.dt.hour\n",
    "CAT = [\"category_top\",\"customer_state\",\"seller_state\",\"payment_type\"]\n",
    "for c in CAT: d[c] = d[c].fillna(\"unknown\").astype(\"category\")\n",
    "HIST = [\"seller_n_prior\",\"seller_late_rate\",\"seller_mean_days\"]\n",
    "NUM = [\"est_days\",\"distance_km\",\"same_state\",\"price\",\"freight\",\"freight_ratio\",\"weight_g\",\"volume_cm3\",\"n_items\",\"n_sellers\",\n",
    "       \"max_installments\",\"purchase_month\",\"purchase_dow\",\"purchase_hour\"]\n",
    "FEAT = NUM + HIST + CAT\n",
    "\n",
    "cut = d.order_purchase_timestamp.quantile(0.8)\n",
    "tr, te = d[d.order_purchase_timestamp < cut], d[d.order_purchase_timestamp >= cut]\n",
    "vcut = tr.order_purchase_timestamp.quantile(0.85)\n",
    "tr_in, va = tr[tr.order_purchase_timestamp < vcut], tr[tr.order_purchase_timestamp >= vcut]\n",
    "print(f\"train {len(tr):,} (inner {len(tr_in):,} / val {len(va):,}) | test {len(te):,} | cutoff {cut.date()}\")\n",
    "print(\"late rate train/test:\", tr.late.mean().round(3), te.late.mean().round(3), \"| mean days train/test:\", tr.delivery_days.mean().round(1), te.delivery_days.mean().round(1))"
   ]
