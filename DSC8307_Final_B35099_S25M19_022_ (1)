    "def rd(name, **kw): return pd.read_csv(os.path.join(DATA_DIR, name), **kw)\n",
    "date_cols = [\"order_purchase_timestamp\",\"order_approved_at\",\"order_delivered_carrier_date\",\n",
    "             \"order_delivered_customer_date\",\"order_estimated_delivery_date\"]\n",
    "orders = rd(\"olist_orders_dataset.csv\", parse_dates=date_cols)\n",
    "items  = rd(\"olist_order_items_dataset.csv\", parse_dates=[\"shipping_limit_date\"])\n",
    "pay    = rd(\"olist_order_payments_dataset.csv\")\n",
    "rev    = rd(\"olist_order_reviews_dataset.csv\")\n",
    "cust   = rd(\"olist_customers_dataset.csv\")\n",
    "sell   = rd(\"olist_sellers_dataset.csv\")\n",
    "prod   = rd(\"olist_products_dataset.csv\")\n",
    "geo    = rd(\"olist_geolocation_dataset.csv\")\n",
    "trans  = rd(\"product_category_name_translation.csv\")\n",
    "tables = dict(orders=orders, items=items, payments=pay, reviews=rev, customers=cust,\n",
    "              sellers=sell, products=prod, geolocation=geo, translation=trans)\n",
    "pd.DataFrame({k: {\"rows\": len(v), \"cols\": v.shape[1]} for k, v in tables.items()}).T"
   ]
