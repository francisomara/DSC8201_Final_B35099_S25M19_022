    "bk = it.merge(orders[[\"order_id\",\"order_purchase_timestamp\"]], on=\"order_id\")\n",
    "ohe = pd.crosstab(bk.order_id, bk.category).clip(upper=1).astype(bool)\n",
    "n_cat = ohe.sum(axis=1)\n",
    "print(f\"orders: {len(ohe):,} | single-category: {(n_cat==1).mean():.1%} | multi-category: {(n_cat>1).sum():,} orders ({(n_cat>1).mean():.1%})\")\n",
    "\n",
    "# Single-item orders can never show a co-purchase, so lift is computed within MULTI-ITEM orders (the population where co-purchase is possible)\n",
    "n_it = bk.groupby(\"order_id\").size()\n",
    "multi_orders = n_it.index[n_it >= 2]\n",
    "bk_m = bk[bk.order_id.isin(multi_orders)]\n",
    "ohe = ohe.loc[multi_orders]\n",
    "print(f\"multi-item orders: {len(ohe):,} ({len(ohe)/len(n_it):.1%} of orders); of these, {(ohe.sum(axis=1) > 1).mean():.1%} span >1 category\")\n",
    "\n",
    "def pair_table(X, min_count=10, min_lift=1.0):\n",
    "    n, cols = len(X), np.array(X.columns)\n",
    "    M = X.values.astype(np.float32)\n",
    "    co, c = M.T @ M, M.sum(0)\n",
    "    iu = np.triu_indices(len(c), 1)\n",
    "    t = pd.DataFrame({\"a\": cols[iu[0]], \"b\": cols[iu[1]], \"count\": co[iu].astype(int), \"ca\": c[iu[0]], \"cb\": c[iu[1]]})\n",
    "    t[\"support\"] = t[\"count\"] / n\n",
    "    t[\"lift\"] = t[\"count\"] * n / (t.ca * t.cb)\n",
    "    t[\"conf_a_to_b\"] = t[\"count\"] / t.ca\n",
    "    t[\"conf_b_to_a\"] = t[\"count\"] / t.cb\n",
    "    t[\"leverage\"] = t.support - (t.ca / n) * (t.cb / n)\n",
    "    return t[(t[\"count\"] >= min_count) & (t.lift > min_lift)].sort_values(\"lift\", ascending=False).reset_index(drop=True)\n",
    "\n",
    "MIN_COUNT = 10   # only ~0.8% of orders are multi-category, so 30 would leave almost nothing; pairs seen <10 times are treated as noise\n",
    "pairs = pair_table(ohe, MIN_COUNT)\n",
    "print(\"pairs with lift>1 and >= %d co-occurrences: %d\" % (MIN_COUNT, len(pairs)))\n",
