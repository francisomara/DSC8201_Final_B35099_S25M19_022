    "from sklearn.ensemble import IsolationForest\n",
    "from sklearn.neighbors import LocalOutlierFactor\n",
    "from sklearn.covariance import MinCovDet\n",
    "from sklearn.preprocessing import RobustScaler\n",
    "\n",
    "A = master[master.price.notna()].copy().reset_index(drop=True)\n",
    "A[\"payment_gap\"] = A.payment_value - (A.price + A.freight)\n",
    "A[\"gap_ratio\"] = A.payment_gap.abs() / (A.price + A.freight).replace(0, np.nan)\n",
    "AF = [\"price\",\"freight\",\"freight_ratio\",\"n_items\",\"n_sellers\",\"payment_gap\",\"max_installments\",\"weight_g\",\"volume_cm3\",\"delivery_days\",\"delay_days\",\"review_score\"]\n",
    "slog = lambda s: np.sign(s) * np.log1p(s.abs())\n",
    "XA = A[AF].copy()\n",
    "for c in [\"price\",\"freight\",\"freight_ratio\",\"n_items\",\"weight_g\",\"volume_cm3\",\"delivery_days\"]: XA[c] = np.log1p(XA[c].clip(lower=0))\n",
    "for c in [\"payment_gap\",\"delay_days\"]: XA[c] = slog(XA[c])\n",
    "XA = XA.fillna(XA.median())            # undelivered orders get median delivery features; status is handled in the rule layer\n",
    "ZA = RobustScaler().fit_transform(XA)\n",
    "print(ZA.shape)\n",
    "\n",
    "def iforest(seed): return -IsolationForest(n_estimators=300, random_state=seed, n_jobs=-1).fit(ZA).score_samples(ZA)\n",
    "A[\"s_if\"] = iforest(SEED)\n",
    "lof = LocalOutlierFactor(n_neighbors=35, n_jobs=-1); lof.fit_predict(ZA); A[\"s_lof\"] = -lof.negative_outlier_factor_\n",
    "sub = rng.choice(len(ZA), min(20000, len(ZA)), replace=False)\n",
    "mcd = MinCovDet(support_fraction=0.75, random_state=SEED).fit(ZA[sub]); A[\"s_mcd\"] = mcd.mahalanobis(ZA)\n",
    "for c in [\"s_if\",\"s_lof\",\"s_mcd\"]: A[c + \"_r\"] = A[c].rank(pct=True)\n",
    "A[\"score\"] = A[[\"s_if_r\",\"s_lof_r\",\"s_mcd_r\"]].mean(axis=1)"
   ]
